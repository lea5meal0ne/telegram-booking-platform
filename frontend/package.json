{
  "name": "telegram-booking-mini-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "tsc --noEmit && node ../scripts/check-locales.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e *.ts *.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "@telegram-apps/sdk-react": "^3.0.0",
    "i18next": "^24.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "valibot": "^1.4.2"
  }
}
